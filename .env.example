# Copiá este archivo a `.env` y completá los valores. `.env` no se commitea.
# Con docker-compose.yml, el usuario y la base son `mi_grilla`, y PASSWORD es el mismo valor que
# POSTGRES_PASSWORD.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mi_grilla
POSTGRES_PASSWORD=

# La base que vacían los tests de integración y que llenan de cuentas los E2E: en el mismo servidor,
# pero distinta de DATABASE_URL (si es la misma, los tests se niegan a correr). Se crea, se migra y
# se siembra con `pnpm db:test:prepare`.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mi_grilla_test

# Better Auth (cuentas, FEAT-002). El secreto firma las cookies de sesión: 32 caracteres o más.
# Generalo con `openssl rand -base64 32` y no lo reuses entre entornos.
BETTER_AUTH_SECRET=
# La URL pública de la app. Con https, la cookie de sesión es `Secure` y lleva el prefijo `__Secure-`.
BETTER_AUTH_URL=http://localhost:3000
